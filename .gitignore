# Build outputs (regenerated every build)
**/build/
**/.gradle/
**/.kotlin/
.dart_tool/
.cxx/
.externalNativeBuild/
captures/

# IDE / local machine files
.idea/
*.iml
local.properties
**/local.properties

# Signing & secrets (never commit)
*.jks
*.keystore
.env
**/.env

# Installable packages
*.apk
!releases/*.apk
*.aab

# Archives left over from the legacy Flutter app
_archive/**/build/
_archive/**/.gradle/
_archive/**/.kotlin/
_archive/**/ephemeral/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
*.swp
*.pyc
